# Copy to .env and fill in. HMAC secrets for each source in config/sources.yaml.
SRC_DATADOG_SECRET=change-me
SRC_CLOUDWATCH_SECRET=change-me
SRC_AZURE_SECRET=change-me
SRC_GENERIC_SECRET=change-me

# Optional
ANTHROPIC_API_KEY=
TEAMS_WEBHOOK_URL=
APP_BASE_URL=http://localhost:8000

# Run the sample shop + log watcher inside the app, so a deployed demo shows live alerts
DEMO_MODE=false
