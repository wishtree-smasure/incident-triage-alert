{
  "name": "incident-triage",
  "version": "0.2.0",
  "description": "Incident Triage Agent - receives signed alerts, de-duplicates them and shows them on a dashboard",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "send-samples": "tsx scripts/send-samples.ts",
    "generate-traffic": "tsx scripts/generate-traffic.ts",
    "watch-logs": "tsx scripts/watch-logs.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.8",
    "nunjucks": "^3.2.4",
    "pg": "^8.23.1",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.43",
    "@types/nunjucks": "^3.2.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
